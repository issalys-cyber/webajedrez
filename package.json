{
  "name": "webajedrez",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @webajedrez/web",
    "build": "npm run build -w @webajedrez/web",
    "start": "npm run start -w @webajedrez/web",
    "typecheck": "npm run typecheck -w @webajedrez/web",
    "verify": "npm run typecheck && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "smoke:bot": "node scripts/smoke-bot.mjs",
    "check:uci": "node scripts/uci-moves-check.mjs",
    "check:engine": "node scripts/engine-check.mjs",
    "check:hint": "node scripts/hint-check.mjs",
    "test:node": "npm run check:uci && npm run check:engine",
    "test:browser": "npm run smoke && npm run smoke:bot && npm run check:hint"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
